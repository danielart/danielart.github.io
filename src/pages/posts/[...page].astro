---
import type { GetStaticPaths } from "astro";
import { getCollection } from "astro:content";
import type { CollectionEntry } from "astro:content";
import Main from "@/layouts/Main.astro";
import Layout from "@/layouts/Layout.astro";
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import Card from "@/components/Card.astro";
import Pagination from "@/components/Pagination.astro";
import LanguageSelector from "@/components/LanguageSelector.astro";
import getSortedPosts from "@/utils/getSortedPosts";
import { SITE } from "@/config";
import {
  getCollectionAlternateLanguages,
  getCollectionCanonicalUrl,
  getCollectionDescription,
  SITE_LANGUAGES,
} from "@/utils/seo";

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection(
    "blog",
    ({ data }: CollectionEntry<"blog">) => !data.draft
  );
  const enPosts = posts.filter(
    (post: CollectionEntry<"blog">) => post.data.lang === "en"
  );
  return paginate(getSortedPosts(enPosts), { pageSize: SITE.postPerPage });
}) satisfies GetStaticPaths;

const { page } = Astro.props;
const allPublishedPosts = await getCollection(
  "blog",
  ({ data }: CollectionEntry<"blog">) => !data.draft
);
const availableLanguages = SITE_LANGUAGES.filter(lang => {
  const postCount = allPublishedPosts.filter(
    post => post.data.lang === lang
  ).length;
  return postCount > (page.currentPage - 1) * SITE.postPerPage;
});
const description = getCollectionDescription("en", page.currentPage);
const canonicalURL = getCollectionCanonicalUrl("en", page.currentPage);
const alternateLanguages = getCollectionAlternateLanguages(
  page.currentPage,
  availableLanguages
);
---

<Layout
  title={`Posts | ${SITE.siteName}`}
  headline="Posts"
  {description}
  {canonicalURL}
  {alternateLanguages}
  pageType="collection"
  lang="en"
>
  <Header />
  <Main pageTitle="Posts" pageDesc={description}>
    <LanguageSelector currentLang="en" />
    <ul>
      {page.data.map(data => <Card {...data} />)}
    </ul>
  </Main>

  <Pagination {page} />

  <Footer noMarginTop={page.lastPage > 1} />
</Layout>
