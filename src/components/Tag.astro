---
import IconHash from "@/assets/icons/IconHash.svg";

type Props = {
  tag: string;
  tagName: string;
  size?: "sm" | "lg";
  count?: number;
};

const { tag, tagName, size = "lg", count } = Astro.props;
---

<li>
  <a
    href={`/tags/${tag}/`}
    transition:name={tag}
    class:list={[
      "group inline-flex items-center gap-1.5 rounded-lg border border-border/60 bg-muted/40 font-medium transition-all duration-200 hover:-translate-y-0.5 hover:border-accent/60 hover:bg-accent/10 hover:text-accent focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent",
      { "text-xs px-2.5 py-1": size === "sm" },
      { "text-sm px-3.5 py-1.5": size === "lg" },
    ]}
  >
    <IconHash
      class:list={[
        "opacity-60 transition-colors group-hover:text-accent group-hover:opacity-100",
        { "size-3.5": size === "sm" },
        { "size-4": size === "lg" },
      ]}
    />
    <span>{tagName}</span>
    {
      count !== undefined && (
        <span
          class:list={[
            "ml-1 rounded bg-border/40 font-mono opacity-70 transition-colors group-hover:bg-accent/20 group-hover:opacity-100",
            { "px-1.5 py-0.2 text-[11px]": size === "sm" },
            { "px-2 py-0.5 text-xs": size === "lg" },
          ]}
        >
          {count}
        </span>
      )
    }
  </a>
</li>
