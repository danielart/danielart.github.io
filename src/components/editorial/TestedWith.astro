---
interface Props {
  tools?: string[];
  title?: string;
}

const { tools = [], title = "Tested With" } = Astro.props;
---

<div
  class="my-4 flex flex-wrap items-center gap-2 rounded-lg border border-border/40 bg-muted/30 px-4 py-2 text-xs"
>
  <span class="font-mono font-semibold text-accent/80 uppercase">{title}:</span>
  {
    tools.map(tool => (
      <span class="rounded bg-accent/10 px-2 py-0.5 font-mono font-medium text-accent">
        {tool}
      </span>
    ))
  }
  <slot />
</div>
