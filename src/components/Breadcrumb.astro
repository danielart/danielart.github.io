---
// Remove current url path and remove trailing slash if exists
const currentUrlPath = Astro.url.pathname.replace(/\/+$/, "");

// Get url array from path
// eg: /tags/tailwindcss => ['tags', 'tailwindcss']
const breadcrumbList = currentUrlPath.split("/").slice(1);

// if breadcrumb is Home > Posts > 1 <etc>
// replace Posts with Posts (page number)
if (breadcrumbList[0] === "posts") {
  const isLang = ["en", "es", "ja", "pt"].includes(breadcrumbList[1]);
  if (isLang) {
    breadcrumbList.splice(
      0,
      3,
      `Posts ${breadcrumbList[1].toUpperCase()} (page ${breadcrumbList[2] || 1})`
    );
  } else {
    breadcrumbList.splice(0, 2, `Posts (page ${breadcrumbList[1] || 1})`);
  }
}

// if breadcrumb is Home > Tags > [tag] > [page] <etc>
// replace [tag] > [page] with [tag] (page number)
if (breadcrumbList[0] === "tags" && !isNaN(Number(breadcrumbList[2]))) {
  breadcrumbList.splice(
    1,
    3,
    `${breadcrumbList[1]} ${Number(breadcrumbList[2]) === 1 ? "" : "(page " + breadcrumbList[2] + ")"}`
  );
}
---

<nav
  class="no-scrollbar app-layout mt-8 mb-8 overflow-x-auto font-mono sm:mb-10"
  aria-label="breadcrumb"
>
  <ol
    class="inline-flex max-w-full items-center gap-2.5 py-1 text-xs font-medium sm:text-sm"
  >
    {/* Home Circuit Node */}
    <li class="group/circuit flex items-center gap-2.5">
      <a
        href="/"
        class="group/node relative inline-flex items-center gap-2.5 rounded-full border border-border/60 bg-muted/50 px-4 py-2 text-foreground/80 transition-all duration-300 hover:-translate-y-0.5 hover:scale-105 hover:border-accent hover:text-accent hover:shadow-[0_0_20px_rgba(224,92,54,0.3)]"
      >
        {/* Expanding Radial Ripple Ring on Hover */}
        <span
          class="pointer-events-none absolute inset-0 -z-10 rounded-full border border-accent/60 opacity-0 transition-all duration-500 ease-out group-hover/node:scale-140 group-hover/node:opacity-100"
          aria-hidden="true"></span>
        <span
          class="pointer-events-none absolute -inset-1 -z-20 rounded-full bg-accent/20 opacity-0 blur-sm transition-opacity duration-300 group-hover/node:opacity-100"
          aria-hidden="true"></span>

        {/* Node Pulse Core */}
        <span class="relative flex size-2.5 items-center justify-center">
          <span
            class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-0 group-hover/node:opacity-75"
          ></span>
          <span
            class="relative inline-flex size-2 rounded-full bg-accent/70 transition-transform duration-300 group-hover/node:scale-125 group-hover/node:bg-accent"
          ></span>
        </span>

        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="size-4 stroke-current transition-transform duration-300 group-hover/node:scale-110 group-hover/node:-rotate-12"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
        >
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
          <polyline points="9 22 9 12 15 12 15 22"></polyline>
        </svg>
        <span
          class="text-[11px] font-semibold tracking-wider uppercase sm:text-xs"
          >Home</span
        >
      </a>

      {/* Connected Circuit Line & Flow Particle */}
      <div
        class="flex items-center gap-1 text-foreground/30 transition-colors duration-300 group-hover/circuit:text-accent"
        aria-hidden="true"
      >
        <span
          class="h-0.5 w-3 bg-current transition-all duration-300 group-hover/circuit:w-5 group-hover/circuit:bg-accent"
        ></span>
        <span
          class="size-1.5 rounded-full bg-current transition-all duration-300 group-hover/circuit:scale-150 group-hover/circuit:bg-accent group-hover/circuit:shadow-[0_0_8px_var(--accent)]"
        ></span>
        <span
          class="h-0.5 w-3 bg-current transition-all duration-300 group-hover/circuit:w-5 group-hover/circuit:bg-accent"
        ></span>
      </div>
    </li>

    {
      breadcrumbList.map((breadcrumb, index) => {
        const isLast = index + 1 === breadcrumbList.length;
        return isLast ? (
          <li>
            <span
              class:list={[
                "relative inline-flex items-center gap-2.5 rounded-full border border-accent/60 bg-accent/15 px-4.5 py-2 text-[11px] font-bold tracking-wider text-accent uppercase shadow-[0_0_15px_rgba(224,92,54,0.3)] sm:text-xs",
                { lowercase: index > 0 },
              ]}
              aria-current="page"
            >
              {/* Active Node Core */}
              <span class="relative flex size-2.5 items-center justify-center">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75" />
                <span class="relative inline-flex size-2 rounded-full bg-accent" />
              </span>
              {decodeURIComponent(breadcrumb)}
            </span>
          </li>
        ) : (
          <li class="group/circuit flex items-center gap-2.5">
            <a
              href={`/${breadcrumb}/`}
              class="group/node relative inline-flex items-center gap-2.5 rounded-full border border-border/60 bg-muted/50 px-4 py-2 text-[11px] tracking-wider text-foreground/80 capitalize transition-all duration-300 hover:-translate-y-0.5 hover:scale-105 hover:border-accent hover:text-accent hover:shadow-[0_0_20px_rgba(224,92,54,0.3)] sm:text-xs"
            >
              {/* Expanding Radial Ripple Ring on Hover */}
              <span
                class="pointer-events-none absolute inset-0 -z-10 rounded-full border border-accent/60 opacity-0 transition-all duration-500 ease-out group-hover/node:scale-140 group-hover/node:opacity-100"
                aria-hidden="true"
              />
              <span
                class="pointer-events-none absolute -inset-1 -z-20 rounded-full bg-accent/20 opacity-0 blur-sm transition-opacity duration-300 group-hover/node:opacity-100"
                aria-hidden="true"
              />

              {/* Node Pulse Core */}
              <span class="relative flex size-2.5 items-center justify-center">
                <span class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-0 group-hover/node:opacity-75" />
                <span class="relative inline-flex size-2 rounded-full bg-accent/70 transition-transform duration-300 group-hover/node:scale-125 group-hover/node:bg-accent" />
              </span>

              <span>{breadcrumb}</span>
            </a>

            {/* Connected Circuit Line & Flow Particle */}
            <div
              class="flex items-center gap-1 text-foreground/30 transition-colors duration-300 group-hover/circuit:text-accent"
              aria-hidden="true"
            >
              <span class="h-0.5 w-3 bg-current transition-all duration-300 group-hover/circuit:w-5 group-hover/circuit:bg-accent" />
              <span class="size-1.5 rounded-full bg-current transition-all duration-300 group-hover/circuit:scale-150 group-hover/circuit:bg-accent group-hover/circuit:shadow-[0_0_8px_var(--accent)]" />
              <span class="h-0.5 w-3 bg-current transition-all duration-300 group-hover/circuit:w-5 group-hover/circuit:bg-accent" />
            </div>
          </li>
        );
      })
    }
  </ol>
</nav>
