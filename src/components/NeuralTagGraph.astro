---
import type { Tag } from "@/utils/getUniqueTags";

interface Props {
  id: string;
  title: string;
  subtitle?: string;
  tags: Tag[];
  connections: { source: string; target: string; weight: number }[];
  heightClass?: string;
}

const {
  id,
  title,
  subtitle,
  tags,
  connections,
  heightClass = "h-[300px] sm:h-[380px]",
} = Astro.props;
---

<div
  class="group relative mb-8 w-full overflow-hidden rounded-2xl border border-accent/25 bg-background/80 p-4 shadow-xl backdrop-blur-md transition-all duration-300 hover:border-accent/40"
>
  <!-- Graph Header -->
  <div class="mb-3 flex flex-wrap items-center justify-between gap-2 px-2 pt-1">
    <div class="flex items-center gap-2.5">
      <span class="relative flex size-3">
        <span
          class="absolute inline-flex h-full w-full animate-ping rounded-full bg-accent opacity-75"
        ></span>
        <span class="relative inline-flex size-3 rounded-full bg-accent"></span>
      </span>
      <h3
        class="font-mono text-xs font-bold tracking-widest text-accent uppercase sm:text-sm"
      >
        {title}
      </h3>
    </div>
    <div class="flex items-center gap-3 font-mono text-xs opacity-60">
      <span>{tags.length} Nodes</span>
      <span>{connections.length} Synapses</span>
      {subtitle && <span class="hidden sm:inline">{subtitle}</span>}
    </div>
  </div>

  <!-- Canvas Container -->
  <div class="relative w-full overflow-hidden rounded-xl bg-muted/20">
    <canvas
      id={`neural-canvas-${id}`}
      class:list={[heightClass, "w-full cursor-pointer touch-none"]}></canvas>
  </div>
</div>

<script
  is:inline
  define:vars={{ graphId: id, graphTags: tags, graphConnections: connections }}
>
  (function () {
    function initGraphInstance() {
      const canvasId = `neural-canvas-${graphId}`;
      const canvas = document.getElementById(canvasId);
      if (!canvas) return;

      const ctx = canvas.getContext("2d");
      if (!ctx) return;

      let width = 0;
      let height = 0;
      let dpr = window.devicePixelRatio || 1;
      let animFrameId = null;
      let isVisible = false;
      let initializedNodes = false;

      function resizeCanvas() {
        const rect = canvas.getBoundingClientRect();
        const w =
          rect.width ||
          canvas.clientWidth ||
          canvas.parentElement?.clientWidth ||
          300;
        const h = rect.height || canvas.clientHeight || 280;

        if (w === 0 || h === 0) return false;

        width = w;
        height = h;
        dpr = window.devicePixelRatio || 1;

        canvas.width = Math.floor(width * dpr);
        canvas.height = Math.floor(height * dpr);
        ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
        return true;
      }

      resizeCanvas();

      if (graphTags.length === 0) return;

      const maxCount = Math.max(...graphTags.map(t => t.count), 1);
      const nodesMap = new Map();
      let nodes = [];
      let edges = [];

      function setupNodes() {
        if (!resizeCanvas() && width === 0) {
          width = 320;
          height = 280;
        }

        const centerX = width / 2;
        const centerY = height / 2;
        const radiusX = Math.max(60, Math.min(width, height) * 0.35);
        const radiusY = Math.max(50, Math.min(width, height) * 0.3);

        nodesMap.clear();

        nodes = graphTags.map((t, idx) => {
          const nodeRadius = Math.max(
            12,
            Math.min(18, 12 + (t.count / maxCount) * 6)
          );

          // Multi-ring arrangement to prevent overlap
          const ring = idx % 2 === 0 ? 0.95 : 0.55;
          const angle = (idx / graphTags.length) * Math.PI * 2 + idx * 0.4;

          const initialX = centerX + Math.cos(angle) * (radiusX * ring);
          const initialY = centerY + Math.sin(angle) * (radiusY * ring);

          const node = {
            id: t.tag,
            name: t.tagName,
            count: t.count,
            x: initialX,
            y: initialY,
            vx: (Math.random() - 0.5) * 0.2,
            vy: (Math.random() - 0.5) * 0.2,
            radius: nodeRadius,
            collisionRadius: Math.max(nodeRadius + 42, 52),
            isHovered: false,
            isConnected: false,
          };

          nodesMap.set(t.tag, node);
          return node;
        });

        // Map edges directly to the newly created node instances
        edges = graphConnections
          .map(c => {
            const source = nodesMap.get(c.source);
            const target = nodesMap.get(c.target);
            if (!source || !target) return null;
            return {
              source,
              target,
              weight: c.weight,
              pulses: [],
            };
          })
          .filter(Boolean);

        initializedNodes = true;
      }

      setupNodes();

      const mouse = { x: -1000, y: -1000, active: false };
      let hoveredNode = null;
      let frameCount = 0;

      function getAccentColor(alpha = 1) {
        const style = getComputedStyle(document.documentElement);
        const accent =
          style.getPropertyValue("--color-accent") || "hsl(217, 91%, 60%)";
        if (accent.startsWith("hsl")) {
          return accent.replace(")", `, ${alpha})`).replace("hsl(", "hsla(");
        }
        return accent;
      }

      function getTextColor() {
        const isDark = document.documentElement.classList.contains("dark");
        return isDark ? "#f8fafc" : "#0f172a";
      }

      function getPillBgColor(isHovered) {
        const isDark = document.documentElement.classList.contains("dark");
        if (isHovered) {
          return isDark
            ? "rgba(15, 23, 42, 0.95)"
            : "rgba(255, 255, 255, 0.98)";
        }
        return isDark ? "rgba(30, 41, 59, 0.92)" : "rgba(241, 245, 249, 0.94)";
      }

      function updatePhysics() {
        if (!initializedNodes || width === 0) return;
        const cX = width / 2;
        const cY = height / 2;

        for (let i = 0; i < nodes.length; i++) {
          const node = nodes[i];

          // Gentle central attraction
          node.vx += (cX - node.x) * 0.0008;
          node.vy += (cY - node.y) * 0.0008;

          // Strong collision repulsion accounting for label pill width and height
          for (let j = i + 1; j < nodes.length; j++) {
            const other = nodes[j];
            const dx = other.x - node.x;
            const dy = other.y - node.y;
            const dist = Math.hypot(dx, dy) || 1;
            const minDist = node.collisionRadius + other.collisionRadius;

            if (dist < minDist) {
              const force = ((minDist - dist) / dist) * 0.07;
              node.vx -= dx * force;
              node.vy -= dy * force;
              other.vx += dx * force;
              other.vy += dy * force;
            }
          }

          // Mouse repulsion
          if (mouse.active) {
            const mdx = mouse.x - node.x;
            const mdy = mouse.y - node.y;
            const mdist = Math.hypot(mdx, mdy);
            if (mdist < 100 && mdist > 0) {
              const force = ((100 - mdist) / 100) * 0.06;
              node.vx -= (mdx / mdist) * force * 2;
              node.vy -= (mdy / mdist) * force * 2;
            }
          }

          // Edge spring forces
          edges.forEach(edge => {
            const dx = edge.target.x - edge.source.x;
            const dy = edge.target.y - edge.source.y;
            const dist = Math.hypot(dx, dy) || 1;
            const idealDist = 120;

            if (dist > idealDist) {
              const force = (dist - idealDist) * 0.0002;
              edge.source.vx += dx * force;
              edge.source.vy += dy * force;
              edge.target.vx -= dx * force;
              edge.target.vy -= dy * force;
            }
          });

          // Damping
          node.vx *= 0.85;
          node.vy *= 0.85;

          node.x += node.vx;
          node.y += node.vy;

          // Soft boundary margins (keep inside 12% - 88% canvas bounds)
          const padX = width * 0.12;
          const padY = height * 0.12;

          if (node.x < padX) node.vx += (padX - node.x) * 0.08;
          if (node.x > width - padX)
            node.vx -= (node.x - (width - padX)) * 0.08;
          if (node.y < padY) node.vy += (padY - node.y) * 0.08;
          if (node.y > height - padY)
            node.vy -= (node.y - (height - padY)) * 0.08;
        }

        // Pulse updates
        frameCount++;
        if (frameCount % 30 === 0 && edges.length > 0) {
          const randEdge = edges[Math.floor(Math.random() * edges.length)];
          if (randEdge) {
            randEdge.pulses.push({
              progress: 0,
              speed: 0.015 + Math.random() * 0.015,
            });
          }
        }

        edges.forEach(edge => {
          edge.pulses.forEach(p => (p.progress += p.speed));
          edge.pulses = edge.pulses.filter(p => p.progress < 1);
        });
      }

      function render() {
        if (!initializedNodes || width === 0) return;
        ctx.clearRect(0, 0, width, height);

        // Hover detection
        hoveredNode = null;
        for (const node of nodes) {
          const dist = Math.hypot(mouse.x - node.x, mouse.y - node.y);
          node.isHovered = dist <= node.radius + 12;
          if (node.isHovered) hoveredNode = node;
          node.isConnected = false;
        }

        if (hoveredNode) {
          edges.forEach(edge => {
            if (edge.source === hoveredNode) edge.target.isConnected = true;
            if (edge.target === hoveredNode) edge.source.isConnected = true;
          });
        }

        // 1. Draw Synapses
        edges.forEach(edge => {
          const isHighlighted =
            hoveredNode &&
            (edge.source === hoveredNode || edge.target === hoveredNode);
          const isDimmed = hoveredNode && !isHighlighted;

          ctx.beginPath();
          ctx.moveTo(edge.source.x, edge.source.y);
          ctx.lineTo(edge.target.x, edge.target.y);

          if (isHighlighted) {
            ctx.strokeStyle = getAccentColor(0.85);
            ctx.lineWidth = 2.5;
            ctx.shadowColor = getAccentColor(0.6);
            ctx.shadowBlur = 6;
          } else if (isDimmed) {
            ctx.strokeStyle = "rgba(150, 150, 150, 0.08)";
            ctx.lineWidth = 0.8;
            ctx.shadowBlur = 0;
          } else {
            ctx.strokeStyle = "rgba(150, 150, 150, 0.22)";
            ctx.lineWidth = 1.2;
            ctx.shadowBlur = 0;
          }

          ctx.stroke();
          ctx.shadowBlur = 0;

          // Electrical pulses
          edge.pulses.forEach(p => {
            const px =
              edge.source.x + (edge.target.x - edge.source.x) * p.progress;
            const py =
              edge.source.y + (edge.target.y - edge.source.y) * p.progress;

            ctx.beginPath();
            ctx.arc(px, py, 2.5, 0, Math.PI * 2);
            ctx.fillStyle = isDimmed
              ? "rgba(150, 150, 150, 0.15)"
              : getAccentColor(0.9);
            ctx.shadowColor = getAccentColor(1);
            ctx.shadowBlur = 5;
            ctx.fill();
            ctx.shadowBlur = 0;
          });
        });

        // 2. Draw Nodes & Labels
        nodes.forEach(node => {
          const isFocused = node.isHovered || node.isConnected;
          const isDimmed = hoveredNode && !isFocused;

          // Outer Glow Ring
          if (isFocused) {
            ctx.beginPath();
            ctx.arc(node.x, node.y, node.radius + 6, 0, Math.PI * 2);
            ctx.fillStyle = getAccentColor(0.18);
            ctx.fill();

            ctx.beginPath();
            ctx.arc(node.x, node.y, node.radius + 2, 0, Math.PI * 2);
            ctx.strokeStyle = getAccentColor(0.9);
            ctx.lineWidth = 2;
            ctx.shadowColor = getAccentColor(0.8);
            ctx.shadowBlur = 8;
            ctx.stroke();
            ctx.shadowBlur = 0;
          }

          // Node Circle
          ctx.beginPath();
          ctx.arc(node.x, node.y, node.radius, 0, Math.PI * 2);

          if (isFocused) {
            ctx.fillStyle = getAccentColor(1);
          } else if (isDimmed) {
            ctx.fillStyle = "rgba(150, 150, 150, 0.2)";
          } else {
            ctx.fillStyle = getAccentColor(0.8);
          }
          ctx.fill();

          // Render Label Badge
          const labelText = `#${node.name} (${node.count})`;
          ctx.font = isFocused
            ? "bold 11px Inter, system-ui, sans-serif"
            : "11px Inter, system-ui, sans-serif";

          const textWidth = ctx.measureText(labelText).width;
          const pillPaddingX = 7;
          const pillHeight = 18;
          const pillX = node.x - textWidth / 2 - pillPaddingX;
          const pillY = node.y + node.radius + 4;

          if (!isDimmed) {
            ctx.beginPath();
            if (typeof ctx.roundRect === "function") {
              ctx.roundRect(
                pillX,
                pillY,
                textWidth + pillPaddingX * 2,
                pillHeight,
                5
              );
            } else {
              ctx.rect(pillX, pillY, textWidth + pillPaddingX * 2, pillHeight);
            }
            ctx.fillStyle = getPillBgColor(isFocused);
            ctx.strokeStyle = isFocused
              ? getAccentColor(0.9)
              : "rgba(150, 150, 150, 0.3)";
            ctx.lineWidth = 1;
            ctx.fill();
            ctx.stroke();

            ctx.textAlign = "center";
            ctx.textBaseline = "middle";
            ctx.fillStyle = isFocused ? getAccentColor(1) : getTextColor();
            ctx.fillText(labelText, node.x, pillY + pillHeight / 2);
          }
        });
      }

      function loop() {
        if (isVisible) {
          updatePhysics();
          render();
          animFrameId = requestAnimationFrame(loop);
        }
      }

      // Intersection Observer with 250px rootMargin so canvas initializes before entering viewport
      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            isVisible = entry.isIntersecting;
            if (isVisible) {
              if (resizeCanvas()) {
                setupNodes();
              }
              render();
              if (!animFrameId) loop();
            } else if (animFrameId) {
              cancelAnimationFrame(animFrameId);
              animFrameId = null;
            }
          });
        },
        { rootMargin: "250px 0px 250px 0px", threshold: 0 }
      );

      observer.observe(canvas);

      // Force immediate initial setup render
      if (resizeCanvas()) setupNodes();
      render();

      function handlePointerMove(e) {
        const rect = canvas.getBoundingClientRect();
        mouse.x = e.clientX - rect.left;
        mouse.y = e.clientY - rect.top;
        mouse.active = true;

        let isOver = false;
        for (const node of nodes) {
          if (
            Math.hypot(mouse.x - node.x, mouse.y - node.y) <=
            node.radius + 10
          ) {
            isOver = true;
            break;
          }
        }
        canvas.style.cursor = isOver ? "pointer" : "default";
      }

      function handlePointerLeave() {
        mouse.active = false;
        mouse.x = -1000;
        mouse.y = -1000;
        canvas.style.cursor = "default";
      }

      function handleClick(e) {
        const rect = canvas.getBoundingClientRect();
        const cx = e.clientX - rect.left;
        const cy = e.clientY - rect.top;

        for (const node of nodes) {
          if (Math.hypot(cx - node.x, cy - node.y) <= node.radius + 10) {
            window.location.href = `/tags/${node.id}/`;
            break;
          }
        }
      }

      canvas.addEventListener("pointermove", handlePointerMove);
      canvas.addEventListener("pointerleave", handlePointerLeave);
      canvas.addEventListener("click", handleClick);

      window.addEventListener("resize", () => {
        if (resizeCanvas()) {
          setupNodes();
          render();
        }
      });

      // Sync with text links in document
      document.querySelectorAll("a[href^='/tags/']").forEach(link => {
        const href = link.getAttribute("href");
        if (!href) return;
        const parts = href.split("/").filter(Boolean);
        const tagSlug = parts[1];
        if (!tagSlug) return;

        link.addEventListener("mouseenter", () => {
          const targetNode = nodesMap.get(tagSlug);
          if (targetNode) {
            mouse.x = targetNode.x;
            mouse.y = targetNode.y;
            mouse.active = true;
          }
        });

        link.addEventListener("mouseleave", handlePointerLeave);
      });
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", initGraphInstance);
    } else {
      initGraphInstance();
    }

    document.addEventListener("astro:after-swap", initGraphInstance);
  })();
</script>
